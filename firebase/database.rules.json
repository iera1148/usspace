{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'email'])",
        "displayName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "photoURL": { ".validate": "newData.isString() && newData.val().length <= 180000" },
        "coupleId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" },
        "pinHash": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "pinSalt": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "theme": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "darkMode": { ".validate": "newData.isBoolean()" },
        "locationSharing": { ".validate": "newData.isBoolean()" },
        "language": { ".validate": "newData.val() == 'en' || newData.val() == 'ms'" },
        "$other": { ".validate": false }
      }
    },
    "invitations": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() == auth.uid) || (data.exists() && data.child('createdBy').val() == auth.uid))",
        ".validate": "!newData.exists() || newData.hasChildren(['coupleId', 'createdBy', 'expiresAt'])",
        "coupleId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
        "createdBy": { ".validate": "newData.isString() && newData.val() == auth.uid" },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "couples": {
      "$coupleId": {
        ".read": "auth != null && (data.child('ownerId').val() == auth.uid || data.child('partnerId').val() == auth.uid)",
        ".validate": "!newData.exists() || newData.child('ownerId').isString()",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() == auth.uid && !newData.child('partnerId').exists()) || data.child('ownerId').val() == auth.uid || (data.child('partnerId').val() == auth.uid && newData.exists() && newData.child('ownerId').val() == data.child('ownerId').val() && (!newData.child('partnerId').exists() || newData.child('partnerId').val() == data.child('partnerId').val())) || (data.exists() && !data.child('partnerId').exists() && newData.child('partnerId').val() == auth.uid && newData.child('ownerId').val() == data.child('ownerId').val()))",
        "ownerId": {
          ".read": "auth != null",
          ".validate": "!newData.exists() || (newData.isString() && (!data.exists() || newData.val() == data.val()))"
        },
        "partnerId": {
          ".read": "auth != null",
          ".validate": "!newData.exists() || (newData.isString() && (!data.exists() ? newData.val() == auth.uid : newData.val() == data.val()))"
        }
      }
    }
  }
}
