# Copy this file to .env and fill it from Firebase console → Project settings → Your apps → Web app.
# Leave the values empty to use demo mode on this browser only.
# The web API key is shipped to the browser. Real privacy comes from the database rules, not from hiding this key.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Use / for Vercel or a user site. Use /repository-name/ for a GitHub project site.
VITE_BASE=/
